string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(saved "${FIXTURES}/analyse-${suffix}.frametrail")
set(report "${FIXTURES}/analyse-${suffix}.html")
execute_process(COMMAND "${CLI}" analyse "${FIXTURES}/variable.mkv" --detect "${MODEL}" --save "${saved}" --report "${report}"
    RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Analysis failed: ${log} ${error}")
endif()
if(NOT log MATCHES "Analysed in .* s with YOLOX-Nano" OR NOT log MATCHES "Detection took [0-9]+ ms per frame")
    message(FATAL_ERROR "Analysis summary lacks its findings: ${log}")
endif()
file(READ "${report}" page LIMIT 64)
if(NOT page MATCHES "^<!doctype html>")
    message(FATAL_ERROR "Report is not an HTML page")
endif()
execute_process(COMMAND "${CLI}" run "${saved}" RESULT_VARIABLE result OUTPUT_VARIABLE info ERROR_QUIET)
if(NOT result EQUAL 0 OR NOT info MATCHES "Frames analysed: 10")
    message(FATAL_ERROR "Saved analysis does not cover all ten frames: ${info}")
endif()
execute_process(COMMAND "${CLI}" analyse "${FIXTURES}/variable.mkv" --detect "${MODEL}" --zoom --save "${FIXTURES}/analyse-${suffix}-zoom.frametrail"
    RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT log MATCHES "with YOLOX-Nano .+ zoom")
    message(FATAL_ERROR "Zoom analysis failed: ${log} ${error}")
endif()
file(SHA256 "${saved}" before)
execute_process(COMMAND "${CLI}" analyse "${FIXTURES}/variable.mkv" --detect "${MODEL}" --save "${saved}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
file(SHA256 "${saved}" after)
if(result EQUAL 0 OR NOT before STREQUAL after)
    message(FATAL_ERROR "Analysis overwrote an existing result")
endif()
execute_process(COMMAND "${CLI}" analyse "${FIXTURES}/variable.mkv" --detect "${MODEL}" --save "${FIXTURES}/analyse-${suffix}-b.frametrail" --every 0
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
    message(FATAL_ERROR "Analysis accepted an invalid frame step")
endif()
