string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(profile "${FIXTURES}/stage-profile-${suffix}.csv")
execute_process(COMMAND "${CLI}" inspect "${FIXTURES}/variable.mkv" --profile "${profile}" --detect "${MODEL}" --track
    RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Profiling failed: ${log} ${error}")
endif()
file(STRINGS "${profile}" rows)
list(LENGTH rows count)
if(NOT count EQUAL 11)
    message(FATAL_ERROR "Profile must include a header and every one of ten frames")
endif()
list(GET rows 0 header)
if(NOT header STREQUAL "sequence,timestamp_us,width,height,rgb_bytes,decode_rgb_ms,preprocess_ms,inference_ms,postprocess_ms,tracking_ms,pipeline_ms")
    message(FATAL_ERROR "Profile schema mismatch")
endif()
list(GET rows 10 last)
if(NOT last MATCHES "^9,1600000,64,48,9216,")
    message(FATAL_ERROR "Profile frame identity/geometry mismatch")
endif()
list(REMOVE_AT rows 0)
foreach(row IN LISTS rows)
    if(row MATCHES "nan|inf|,-[0-9]")
        message(FATAL_ERROR "Invalid profile measurement: ${row}")
    endif()
endforeach()
file(SHA256 "${profile}" before)
execute_process(COMMAND "${CLI}" inspect "${FIXTURES}/variable.mkv" --profile "${profile}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
file(SHA256 "${profile}" after)
if(result EQUAL 0 OR NOT before STREQUAL after)
    message(FATAL_ERROR "Profiling overwrote an existing result")
endif()
