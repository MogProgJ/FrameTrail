string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(run "${FIXTURES}/small-${suffix}.frametrail")
execute_process(COMMAND "${CLI}" inspect "${FIXTURES}/variable.mkv" --detect "${MODEL}" --model-type small --confidence 0.55 --track --save-run "${run}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT output MATCHES "Model: YOLOX-S" OR NOT output MATCHES "Frames decoded: 10")
    message(FATAL_ERROR "S saved CLI failed: ${output} ${error}")
endif()
execute_process(COMMAND "${CLI}" run "${run}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT output MATCHES "Model: YOLOX-S" OR NOT output MATCHES "Confidence: 0.55")
    message(FATAL_ERROR "S saved settings were lost: ${output} ${error}")
endif()
foreach(case mismatch threshold missing)
    if(case STREQUAL mismatch)
        set(args --detect "${MODEL}" --model-type nano)
    elseif(case STREQUAL threshold)
        set(args --detect "${MODEL}" --model-type small --confidence nan)
    else()
        set(args --model-type small)
    endif()
    set(output_file "${FIXTURES}/invalid-${case}-${suffix}.csv")
    execute_process(COMMAND "${CLI}" inspect "${FIXTURES}/still.png" ${args} --detections "${output_file}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
    if(result EQUAL 0 OR EXISTS "${output_file}")
        message(FATAL_ERROR "Invalid ${case} was accepted or created output")
    endif()
endforeach()
