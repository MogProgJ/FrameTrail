string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(video "${FIXTURES}/track-${suffix}.mkv")
set(tracks "${FIXTURES}/tracks-${suffix}.csv")
set(events "${FIXTURES}/events-${suffix}.csv")
execute_process(COMMAND "${FFMPEG}" -v error -loop 1 -framerate 10 -i "${SAMPLE}"
    -frames:v 6 -c:v ffv1 "${video}" RESULT_VARIABLE result ERROR_VARIABLE error TIMEOUT 15)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Tracking sample generation failed: ${error}")
endif()
execute_process(COMMAND "${CLI}" inspect "${video}" --detect "${MODEL}" --track --classes 16
    --tracks "${tracks}" --events "${events}" --line 0.1,0.5,0.9,0.5 --direction both
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
if(NOT result EQUAL 0 OR NOT output MATCHES "Frames decoded: 6" OR NOT output MATCHES "Crossings")
    message(FATAL_ERROR "Tracking CLI failed: ${output} ${error}")
endif()
file(READ "${tracks}" content)
if(NOT content MATCHES "1,100000,1,16,dog,0," OR NOT content MATCHES "5,500000,1,16,dog,1,")
    message(FATAL_ERROR "Stable dog ID/confirmation missing from track CSV: ${content}")
endif()
file(STRINGS "${events}" event_rows)
list(LENGTH event_rows count)
if(NOT count EQUAL 1)
    message(FATAL_ERROR "Stationary clip invented crossings")
endif()
set(image_tracks "${FIXTURES}/image-tracks-${suffix}.csv")
execute_process(COMMAND "${CLI}" inspect "${SAMPLE}" --detect "${MODEL}" --track --classes 16 --tracks "${image_tracks}"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
file(STRINGS "${image_tracks}" image_rows)
list(LENGTH image_rows count)
if(NOT result EQUAL 0 OR NOT count EQUAL 1)
    message(FATAL_ERROR "One-frame image produced temporal track output: ${error}")
endif()
# Controlled photo translation validates the complete decode/infer/track/rule/export
# chain. It is reproducible integration evidence, not natural-video accuracy evidence.
set(moving "${FIXTURES}/moving-${suffix}.mkv")
set(moving_events "${FIXTURES}/moving-events-${suffix}.csv")
execute_process(COMMAND "${FFMPEG}" -v error -f lavfi -i "color=c=black:s=1000x1000:r=10"
    -loop 1 -framerate 10 -i "${SAMPLE}"
    -filter_complex "[0:v][1:v]overlay=x=100:y=50+40*n:eval=frame" -frames:v 6 -c:v ffv1 "${moving}"
    RESULT_VARIABLE result ERROR_VARIABLE error TIMEOUT 15)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Moving sample generation failed: ${error}")
endif()
execute_process(COMMAND "${CLI}" inspect "${moving}" --detect "${MODEL}" --track --classes 16
    --line 0.1,0.75,0.9,0.75 --events "${moving_events}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
file(READ "${moving_events}" content)
file(STRINGS "${moving_events}" moving_rows)
list(LENGTH moving_rows count)
if(NOT result EQUAL 0 OR NOT count EQUAL 2 OR NOT content MATCHES "1,4,400000,1,16,dog,negative_to_positive,")
    message(FATAL_ERROR "Native crossing export failed: ${output} ${error} ${content}")
endif()
set(filtered_events "${FIXTURES}/filtered-events-${suffix}.csv")
execute_process(COMMAND "${CLI}" inspect "${moving}" --detect "${MODEL}" --track --classes 16
    --line 0.1,0.75,0.9,0.75 --direction reverse --events "${filtered_events}"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error TIMEOUT 30)
file(STRINGS "${filtered_events}" filtered_rows)
list(LENGTH filtered_rows count)
if(NOT result EQUAL 0 OR NOT count EQUAL 1)
    message(FATAL_ERROR "Native crossing direction filter failed: ${error}")
endif()
foreach(case missing_detect missing_track bad_line bad_direction bad_classes duplicate_output alias_output existing_output)
    if(case STREQUAL "missing_detect")
        set(options --track)
    elseif(case STREQUAL "missing_track")
        set(options --detect "${MODEL}" --events "${FIXTURES}/bad-${suffix}.csv")
    elseif(case STREQUAL "bad_line")
        set(options --detect "${MODEL}" --track --line 0,0,0,0)
    elseif(case STREQUAL "bad_direction")
        set(options --detect "${MODEL}" --track --direction sideways)
    elseif(case STREQUAL "bad_classes")
        set(options --detect "${MODEL}" --track --classes 80)
    elseif(case STREQUAL "duplicate_output")
        set(options --detect "${MODEL}" --track --tracks "${FIXTURES}/bad-${suffix}.csv" --events "${FIXTURES}/bad-${suffix}.csv")
    elseif(case STREQUAL "alias_output")
        if(WIN32)
            set(options --detect "${MODEL}" --track --tracks "${FIXTURES}/bad-${suffix}.csv" --events "${FIXTURES}/BAD-${suffix}.CSV")
        else()
            set(options --detect "${MODEL}" --track --tracks "${FIXTURES}/bad-${suffix}.csv" --events "${FIXTURES}/./bad-${suffix}.csv")
        endif()
    else()
        set(options --detect "${MODEL}" --track --tracks "${tracks}")
    endif()
    execute_process(COMMAND "${CLI}" inspect "${video}" ${options} RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
    if(result EQUAL 0)
        message(FATAL_ERROR "Invalid tracking CLI request succeeded: ${case}")
    endif()
endforeach()
