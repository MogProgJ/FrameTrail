string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(csv "${FIXTURES}/detections-${suffix}.csv")
execute_process(COMMAND "${CLI}" inspect "${SAMPLE}" --detect "${MODEL}" --detections "${csv}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT output MATCHES "Frames decoded: 1")
    message(FATAL_ERROR "Detection CLI failed: ${output} ${error}")
endif()
file(READ "${csv}" content)
if(NOT content MATCHES ",dog," OR NOT content MATCHES ",bicycle,")
    message(FATAL_ERROR "Detection CSV missing reference objects")
endif()
execute_process(COMMAND "${CLI}" inspect "${SAMPLE}" --detect "${MODEL}" --detections "${csv}"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
    message(FATAL_ERROR "Detection export replaced an existing file")
endif()
execute_process(COMMAND "${CLI}" inspect "${SAMPLE}" --detections "${FIXTURES}/missing-model-${suffix}.csv"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
    message(FATAL_ERROR "Detection export accepted a missing model option")
endif()
