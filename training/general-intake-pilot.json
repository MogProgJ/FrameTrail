{
  "schema": 1,
  "id": "general-train-intake-pilot-v1",
  "goal": "Acquire and review a bounded publisher-train pilot before scaling broad everyday-object training data.",
  "vocabulary": "openimages-v1",
  "max_images": 600,
  "images_per_category": 12,
  "seed": 17,
  "max_download_bytes": 1000000000,
  "domains": {
    "people_and_transport": ["person", "bicycle", "car", "motorcycle", "bus", "truck", "boat", "airplane"],
    "home_and_furniture": ["chair", "couch", "bed", "kitchen & dining room table", "lamp", "door", "mirror", "clock"],
    "kitchen_and_food": ["bottle", "coffee cup", "bowl", "fork", "spoon", "knife", "apple", "banana", "pizza"],
    "electronics_and_work": ["laptop", "cell phone", "computer keyboard", "mouse", "tv", "camera", "book", "scissors"],
    "personal_and_outdoor": ["backpack", "umbrella", "handbag", "suitcase", "ball", "bench", "traffic light", "stop sign"],
    "animals_and_hard_cases": ["dog", "cat", "bird", "horse", "fox", "rabbit", "deer", "owl", "raccoon", "lantern", "balloon"]
  },
  "hard_slices": ["low_light_rgb", "small_objects", "occlusion", "blur", "fox_dog_confusion"],
  "limits": "Intake candidates only. Requires a publisher-train catalogue, label/rights review and independent evaluation. Domain counts are not guaranteed. This policy does not approve training or select a model."
}
