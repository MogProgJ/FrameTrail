# Round 4: continue the round 3 model on Open Images plus COCO train2017 (mix_coco.py) with the partial-label loss.
# Read by train_job.sh with RUN=round4; cloud/kaggle_round4.sh sets the epoch count.
# The data is four times round 3's and its labels mean something new (complete for 80 types), so the run starts at
# the full learning rate again (train.py's default 1e-4, cosine to zero over the 6 epochs).
# --unverified-weight 0.25: classes nobody vouched for on a photo are pushed towards "absent" at a quarter strength
# (0 would remove nearly all "absent" signal for the classes COCO does not cover; 1 is the old loss). A judgment
# call, to be revisited by the yardsticks, not tuned on them.
# Estimate, not measured: about 156,000 training photos at round 3's speed is about 3.1 h per epoch on a Kaggle T4.
EPOCHS=6
BATCH=8
ACCUM=2
START_FROM=runs/round3/checkpoint_best_total.pth
TRAIN_ARGS="--unverified-weight 0.25"
