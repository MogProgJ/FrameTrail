# Submission settings used by remote_launch.sh (launch/resubmit). KEY=value lines; quote values with spaces.
# Queue probe on 2026-10-24: cpu_il and gpu_a100_il waits are priority-bound (same estimate for 2 h or 24 h),
# dev queues start at once, and the H100 queues start days before gpu_a100_il.
#
# Data: up to three resumable 30-minute parts in the dev CPU queue.
PREPARE_PARTS=3
PREPARE_OPTS="--partition=dev_cpu_il --time=00:30:00 --cpus-per-task=4 --mem=16G"
# GPU smoke test (30 min, dev queue): proves CUDA end to end and measures speed; training waits for it.
SMOKE=1
SMOKE_OPTS=
# Baseline scoring is short: also the dev GPU queue.
BASELINE_OPTS="--partition=dev_gpu_a100_il --time=00:30:00"
# One 24-hour training job on whichever GPU queue starts it first (H100 or A100). Splitting does not help
# when waits are priority-bound, because every later part would queue again.
TRAIN_PARTS=1
TRAIN_OPTS="--partition=gpu_h100_il,gpu_h100,gpu_a100_il"

# Extra jobs (-Action add -Job ...; kit/submit_extra.sh). They never cancel or replace the pilot chain.
# The dev queues allow one running and at most 3 queued jobs per user (bwHPC wiki), shared with the account's
# other project. On 2026-10-25 the first -Action add queued four 30-minute full-data parts in dev_cpu_il
# (7933195-7933198); they filled that limit, so the export was refused (QOSMaxSubmitJobPerUserLimit), and the
# script of that day stopped without listing the queued parts. Extra jobs now use cpu_il and leave the dev slots free.
# smoke-model: CPU export of the GPU smoke test's checkpoint (a few minutes).
EXPORT_OPTS="--partition=cpu_il --time=00:30:00"
# full-data: data/full, 595 classes. Dry run on 2026-10-25: 175,051 train / 6,584 valid / 16,788 test images,
# 3.7 min and 5.2 GB memory just to select them. Estimated at most ~58 GB of images (less, since the pilot's
# are linked); the job stops before downloading if the quota cannot hold FULL_NEED_GB plus 100 GB.
# The pilot's 56k images took 15 min in cpu_il with 16 CPUs, so 3 h is generous; a re-run resumes.
FULL_OPTS="--partition=cpu_il --time=03:00:00 --cpus-per-task=16 --mem=32G"
FULL_NEED_GB=60
