# Phase 2 run: RF-DETR Small on data/full (595 classes), started from the pilot (runs/pilot-small).
# Read by train_job.sh when the job starts; change, commit, then -Action sync to apply while it waits.
# A resumed run keeps the epoch count it started with (train.py), because the cosine schedule is sized from it.
# Sizing (estimate): 175,051 training images at the pilot smoke test's 62.5 images/s on an A100 is about 47 min
# per epoch plus validation, so 26 epochs is about 21 h, inside the 24 h limit. The full-speed test measures it.
EPOCHS=26
BATCH=16
ACCUM=1
START_FROM=runs/pilot-small/checkpoint_best_total.pth
