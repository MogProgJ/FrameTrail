# Round 3: continue the Phase 2 model (runs/full-small) on the same images with the missing labels filled in
# (pseudo_labels.py). Read by train_job.sh with RUN=round3; cloud/kaggle_round3.sh overrides the epoch count and batch.
# The Phase 2 run ended with its learning rate decayed to zero; restarting at the full 1e-4 would undo some of that,
# so this run starts at half of it and decays again (cosine) over its 6 epochs. About 52 min per epoch on a Kaggle T4
# with 38,881 training images (measured in Phase 2), so about 5.2 h.
EPOCHS=6
BATCH=8
ACCUM=2
START_FROM=runs/full-small/checkpoint_best_total.pth
TRAIN_ARGS="--lr 5e-5 --lr-encoder 7.5e-5"
