# Read by train.sbatch when the job starts. Change, commit, then run -Action sync to apply.
# Do not change EPOCHS once a run has started: the cosine schedule is sized from it.
# Smoke test (A100): about 13-15 min per epoch on data/pilot, so 50 epochs is an estimated
# 11-13 h on an A100 (less on an H100), well inside the 24 h limit.
EPOCHS=50
BATCH=16
ACCUM=1
